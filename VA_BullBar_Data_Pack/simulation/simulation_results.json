 "struct": [
  {
   "item": "Recovery lug VA-BB-07 (12 mm 304, dia 30, R35 boss)",
   "lines": [
    "Net tension at hole: 2 x 20 x 12 x 210 MPa = 101 kN (10.3 t) at yield",
    "Shear tear-out (2 planes x 20 mm): 60 kN (6.2 t) at yield",
    "Pin bearing (dia 30 x 12, 1.5 Fy): 113 kN (11.6 t)",
    "Governing: tear-out 60 kN (6.2 t) at yield, ~150 kN (15.3 t) ultimate per lug - before the weld to the 3 mm end panel is considered.",
    "VERDICT: at 12 mm / R35 the lug itself carries ~6.2 t at yield / ~15 t ultimate - adequate for a 2.5-3 t vehicle recovery point PROVIDED the load path is welded through to the chassis bracket (full-penetration fillet both sides, 8 mm leg). The 3 mm end panel alone must not carry it. For a certified rating, test to 2 x GVM."
   ]
  },
  {
   "item": "Side hoop VA-BB-15/16 (CHS 50 x 2.0, 285 mm above end panel)",
   "lines": [
    "I = 87010 mm4, Z = 3480 mm3",
    "Lateral load at the top to reach yield at the root weld: 2.56 kN (262 kgf)",
    "VERDICT: adequate for brush/animal contact and as a handhold; it is not a structural member. Root weld to the 3 mm end panel is the weak link - add a 3 mm doubler or weld through to the end plate."
   ]
  },
  {
   "item": "Centre section as a beam, 5 kN frontal push at mid-span, 700 mm between chassis brackets",
   "lines": [
    "I (sum of centre Z + P2 hat + P3 channel, no composite credit) = 726.5 cm4; Z ~ 161.4 cm3",
    "M = 875 Nm -> sigma = 5 MPa vs 210 MPa yield -> OK  (margin 39x; conclusion holds even if the section is 10x less stiff than summed)"
   ]
  },
  {
   "item": "Centre section as a beam, 10 kN frontal push at mid-span, 700 mm between chassis brackets",
   "lines": [
    "I (sum of centre Z + P2 hat + P3 channel, no composite credit) = 726.5 cm4; Z ~ 161.4 cm3",
    "M = 1750 Nm -> sigma = 11 MPa vs 210 MPa yield -> OK  (margin 19x; conclusion holds even if the section is 10x less stiff than summed)"
   ]
  },
  {
   "item": "Centre section as a beam, 20 kN frontal push at mid-span, 700 mm between chassis brackets",
   "lines": [
    "I (sum of centre Z + P2 hat + P3 channel, no composite credit) = 726.5 cm4; Z ~ 161.4 cm3",
    "M = 3500 Nm -> sigma = 22 MPa vs 210 MPa yield -> OK  (margin 10x; conclusion holds even if the section is 10x less stiff than summed)"
   ]
  },
  {
   "item": "Chassis brackets VA-BB-06 (5 mm U, 4 slots each)",
   "lines": [
    "Slots are 13 x 20 in the web and 15 x 38 in the flange (from the DXF) - M12 clearance as drawn. Use M12 class 8.8 / A4-80 with flat washers; no slot change needed.",
